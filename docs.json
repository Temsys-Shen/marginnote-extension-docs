{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Marginnote Dev Docs",
  "colors": {
    "primary": "#2463EB",
    "light": "#2FAFFA",
    "dark": "#003EB3"
  },
  "favicon": {
    "light": "/images/favicon.png",
    "dark": "/images/favicon.png"
  },
  "navigation": {
    "languages": [
      {
        "language": "zh-CN",
        "navbar": {
          "links": [
            {
              "label": "官网",
              "href": "https://www.marginnote.com.cn/"
            },
            {
              "label": "论坛",
              "href": "https://bbs.marginnote.com.cn/"
            },
            {
              "label": "使用手册",
              "href": "https://manual.marginnote.com.cn/mn4/"
            }
          ]
        },
        "pages": [
          {
            "group": "开始",
            "icon": "flag-pennant",
            "pages": [
              "zh/introduction",
              "zh/ai-dev"
            ]
          },
          {
            "group": "基础",
            "pages": [
              "zh/plugin-base",
              "zh/mnrails",
              "zh/sdk",
              "zh/logo",
              "zh/ui",
              "zh/data-interact",
              "zh/events"
            ],
            "icon": "mug-hot"
          },
          {
            "group": "模板配置",
            "pages": [
              "zh/basic-package",
              "zh/template-bottom",
              "zh/template-surfaces",
              "zh/template-menu",
              "zh/template-plugins",
              "zh/template-ai",
              "zh/template-settings",
              "zh/template-vocabulary",
              "zh/template-validate"
            ],
            "icon": "block-question"
          },
          {
            "group": "深入插件",
            "pages": [
              "zh/network",
              "zh/paths",
              "zh/menu-commands",
              "zh/use-inner-ai",
              "zh/jsaddon"
            ],
            "icon": "plug"
          },
          {
            "group": "API 参考",
            "openapi": "openapi/plugin-api.yaml",
            "icon": "book",
            "pages": [
              "zh/api-ai-warning"
            ]
          }
        ],
        "default": true
      },
      {
        "language": "en",
        "navbar": {
          "links": [
            {
              "label": "Official Site",
              "href": "https://www.marginnote.com/"
            },
            {
              "label": "Forum",
              "href": "https://forum.marginnote.com/"
            },
            {
              "label": "Manual",
              "href": "https://manual.marginnote.com.cn/mn4/en/"
            }
          ]
        },
        "pages": [
          {
            "group": "Getting Started",
            "icon": "flag-pennant",
            "pages": [
              "en/introduction",
              "en/ai-dev"
            ]
          },
          {
            "group": "Basics",
            "icon": "mug-hot",
            "pages": [
              "en/plugin-base",
              "en/mnrails",
              "en/sdk",
              "en/logo",
              "en/ui",
              "en/data-interact",
              "en/events"
            ]
          },
          {
            "group": "Advanced add-on development",
            "icon": "plug",
            "pages": [
              "en/network",
              "en/paths",
              "en/menu-commands",
              "en/use-inner-ai",
              "en/jsaddon"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode",
      "grok",
      "aistudio"
    ]
  },
  "description": "Marginnote 开发文档",
  "icons": {
    "library": "fontawesome"
  },
  "seo": {
    "indexing": "all"
  },
  "logo": {
    "light": "/images/marginnote-logo-light.svg",
    "dark": "/images/marginnote-logo-dark.svg"
  },
  "api": {
    "playground": {
      "display": "simple",
      "proxy": false
    }
  }
}
