{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Marginnote Dev Docs",
  "colors": {
    "primary": "#2463EB",
    "light": "#2FAFFA",
    "dark": "#003EB3"
  },
  "favicon": {
    "light": "/images/favicon.png",
    "dark": "/images/favicon.png"
  },
  "navigation": {
    "languages": [
      {
        "language": "zh-CN",
        "pages": [
          {
            "group": "开始",
            "icon": "flag-pennant",
            "pages": [
              "zh/introduction",
              "zh/ai-dev"
            ]
          },
          {
            "group": "基础",
            "pages": [
              "zh/plugin-base",
              "zh/mnrails",
              "zh/sdk",
              "zh/events",
              "zh/ui"
            ]
          },
          {
            "group": "模板配置",
            "pages": []
          },
          {
            "group": "深入插件",
            "pages": [
              "zh/jsaddon",
              "zh/best-practice"
            ]
          }
        ],
        "default": true
      },
      {
        "language": "en",
        "pages": [
          {
            "group": "Getting Started",
            "pages": [
              "en/introduction",
              "en/quickstart"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Forum",
      "href": "https://bbs.marginnote.com.cn"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "Marginnote 场景模板教程文档",
  "icons": {
    "library": "fontawesome"
  },
  "seo": {
    "indexing": "all"
  },
  "logo": {
    "light": "/images/marginnote-logo-light.svg",
    "dark": "/images/marginnote-logo-dark.svg"
  }
}
